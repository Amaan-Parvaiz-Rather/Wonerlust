<style>
  .btn-search {
    width: 50px !important;
    height: 50px !important;
    background-color: #fe424d;
    color: white;
    border-radius: 50%;
    border: none;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .btn-search:hover {
    background-color: #fe424d;
  }
  .btn-search i {
    font-size: 1.5rem;
    padding: 10px;
  }
  .search-btn{
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .search-btn input {
    width: 300px;
    height: 50px;
    border-radius: 25px;
    border: none;
    padding-left: 30px;
    background-color: #f2f2f2;
    font-size: 1rem;
  }
  .search-btn input:focus {
    outline: none;
    box-shadow: 0 0 5px #fe424d;
  }
</style>

<nav class="navbar sticky-top navbar-expand-md">
  <div class="container-fluid">
    <a class="navbar-brand" href="/"><i class="fa-solid fa-compass" style="color: #ff0000"></i></a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavDropdown"
      aria-controls="navbarNavDropdown"
      aria-expanded="false"
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavDropdown">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" aria-current="page" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/Listing">Explore</a>
        </li>
        <li class="nav-item"></li>
      </ul>
      <div class="navbar-nav ms-auto me-auto">
        <form class="d-flex search-btn">
          <input
            class="form-control me-2"
            type="search"
            placeholder="Search . . . . ."
            aria-label="Search" />
          <button class="btn btn-search" type="submit">
            <i class="fa-solid fa-magnifying-glass" style="color: #ffffff"></i>
          </button>
        </form>
      </div>
    </div>
    <div class="d-flex registeration">
      <a class="nav-link add-new" href="/Listing/new">Add new</a>
      <% if (typeof currentUser == 'undefined') {%>
      <a class="btn btn-danger add-btn login-btn" href="/login">Login</a>
      <a class="btn btn-outline-danger signup-btn" href="/signup">SignUp</a>
      <% }%> <% if(typeof currentUser !== 'undefined') { %>
      <a href="/logout"
        ><i class="fa-solid fa-right-from-bracket fa-2xl" style="color: #f3424d"></i
      ></a>
      <% } %>
    </div>
  </div>
</nav>
